<%= form_with(model: category, class: "category-form") do |form| %>
  <% if category.errors.any? %>
    <div class="flash flash-alert" role="alert">
      <strong>Проверьте заполнение формы:</strong>
      <ul>
        <% category.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :name, "Название (обязательно)" %>
    <%= form.text_field :name, maxlength: 100, required: true,
        placeholder: "Например, Электроника" %>
  </div>

  <div class="form-field">
    <%= form.label :description, "Описание" %>
    <%= form.textarea :description, rows: 4,
        placeholder: "Какие товары входят в эту категорию" %>
  </div>

  <div class="page-actions">
    <%= form.submit "Сохранить категорию", class: "button button-primary" %>
    <%= link_to "Отмена", categories_path, class: "button button-secondary" %>
  </div>
<% end %>