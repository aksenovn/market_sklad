<section class="content-panel form-panel">
  <h2>Добавить товар</h2>

  <%= form_with model: @item, url: supply_supply_items_path(@supply),
      class: "category-form" do |form| %>
    <% if @item.errors.any? %>
      <div class="flash flash-alert" role="alert">
        <ul>
          <% @item.errors.each do |error| %>
            <li><%= error.message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-field">
      <%= form.label :product_id, "Товар" %>
      <%= form.select :product_id,
          @products.map { |product| ["#{product.name} — #{product.sku}", product.id] },
          { prompt: "Выберите товар" }, { required: true } %>
    </div>

    <div class="form-field">
      <%= form.label :quantity, "Количество, шт." %>
      <%= form.number_field :quantity, min: 1, step: 1, required: true %>
    </div>

    <div class="form-field">
      <%= form.label :purchase_price, "Закупочная цена за штуку, ₽" %>
      <%= form.number_field :purchase_price, min: 0, step: "0.01",
          max: "9999999999.99", required: true %>
    </div>

    <div class="page-actions">
      <%= form.submit "Добавить товар", class: "button button-primary" %>
    </div>
  <% end %>
</section>
