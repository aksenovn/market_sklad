<div id="<%= dom_id product %>">
  <div>
    <strong>Name:</strong>
    <%= product.name %>
  </div>

  <div>
    <strong>Sku:</strong>
    <%= product.sku %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= product.description %>
  </div>

  <div>
    <strong>Price:</strong>
    <%= product.price %>
  </div>

  <div>
    <strong>Active:</strong>
    <%= product.active %>
  </div>

  <div>
    <strong>Category:</strong>
    <%= product.category_id %>
  </div>

  <div>
    <strong>Brand:</strong>
    <%= product.brand_id %>
  </div>

</div>
