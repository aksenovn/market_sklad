<%= form_with(model: product, class: "category-form") do |form| %>
  <% if product.errors.any? %>
    <div class="flash flash-alert" role="alert">
      <strong>Проверьте заполнение формы:</strong>
      <ul>
        <% product.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :name, "Название товара (обязательно)" %>
    <%= form.text_field :name, required: true, maxlength: 150 %>
  </div>

  <div class="form-field">
    <%= form.label :sku, "Артикул (обязательно)" %>
    <%= form.text_field :sku, required: true, maxlength: 50,
        placeholder: "Например, SAM-001" %>
  </div>

  <div class="form-field">
    <%= form.label :category_id, "Категория (обязательно)" %>
    <%= form.collection_select :category_id, Category.order(:name),
        :id, :name, { prompt: "Выберите категорию" },
        { required: true } %>
  </div>

  <div class="form-field">
    <%= form.label :brand_id, "Бренд (обязательно)" %>
    <%= form.collection_select :brand_id, Brand.order(:name),
        :id, :name, { prompt: "Выберите бренд" },
        { required: true } %>
  </div>

  <div class="form-field">
    <%= form.label :price, "Цена, ₽ (обязательно)" %>
    <%= form.number_field :price, required: true,
        min: "0.01", max: "9999999999.99", step: "0.01" %>
  </div>

  <div class="form-field">
    <%= form.label :description, "Описание" %>
    <%= form.textarea :description, rows: 5 %>
  </div>

  <div class="form-field">
    <label>
      <%= form.check_box :active %>
      Активен — доступен для новых покупок
    </label>
  </div>

  <div class="page-actions">
    <%= form.submit "Сохранить товар", class: "button button-primary" %>
    <%= link_to "Отмена", products_path, class: "button button-secondary" %>
  </div>
<% end %>
