<div class="account-nav">
  <% if logged_in? %>
    <span class="account-name"><%= current_user.name %></span>
    <%= button_to "Выйти", session_path,
        method: :delete, class: "button button-secondary" %>
  <% else %>
    <%= link_to "Войти", new_session_path, class: "nav-link" %>
    <%= link_to "Регистрация", new_registration_path,
        class: "button button-primary" %>
  <% end %>
</div>
